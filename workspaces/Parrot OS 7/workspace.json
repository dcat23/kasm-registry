{
  "friendly_name": "Parrot OS 7",
  "image_src": "parrot-os.png",
  "description": "Parrot OS 7 desktop for Kasm Workspaces",
  "cores": 2,
  "memory": 5200,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "docker_registry": "https://index.docker.io/v1/",
  "categories": [
    "Development",
    "Desktop"
  ],
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",
  "name": "macchiato23/kasm-parrotos-7:latest",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility":[ 
    {
      "version": "1.18.x",
      "image": "macchiato23/kasm-parrotos-7:latest",
      "uncompressed_size_mb": 16000,
      "available_tags": [
        "develop",
        "latest"
      ]
    },
    {
      "version": "1.17.x",
      "image": "macchiato23/kasm-parrotos-7:latest",
      "uncompressed_size_mb": 16000,
      "available_tags": [
        "develop",
        "latest"
      ]
    },
    {
      "version": "1.16.x",
      "image": "macchiato23/kasm-development:develop",
      "uncompressed_size_mb": 5040,
      "available_tags": [
        "develop"
      ]
    }
  ],
  "run_config": {
    "privileged": true,
    "hostname":"kasm",
    "user":"root"
  },
  "exec_config": {
    "first_launch":{
      "user":"root",
      "cmd":"bash -c '/usr/bin/desktop_ready && apt-get update && apt-get install -y sudo && echo \"kasm-user  ALL=(ALL) NOPASSWD: ALL\" >> /etc/sudoers'"
    }
  }
}